# Vercel -> Google Apps Script integration
# URL of the deployed Google Apps Script Web App.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Long random secret shared between Vercel and the Apps Script project.
# Do not expose this through VITE_* variables or React/browser code.
GOOGLE_APPS_SCRIPT_SECRET=replace_with_a_long_random_secret

# Optional. Only needed if you want local development to call a deployed API.
# Leave empty when using the same-origin /api/contact endpoint on Vercel.
VITE_API_URL=
